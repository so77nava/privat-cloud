# Kopieren nach backend/.env und nach Bedarf anpassen. Alle Werte sind optional.

PORT=3000
# Speicherort für Datenbank und Dateien (relativ zu backend/ oder absolut)
DATA_DIR=./data

# Mind. 32 Zeichen. Leer lassen = wird automatisch erzeugt und in DATA_DIR/.jwt-secret gespeichert.
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

MAX_FILE_SIZE_MB=100
MAX_FILES_PER_UPLOAD=20
# Kommagetrennt, ohne Punkt. Leer = Standardliste (Dokumente, Bilder, Audio/Video, Archive)
ALLOWED_EXTENSIONS=
MIN_PASSWORD_LENGTH=8

# Auf true setzen, sobald die App über HTTPS (z. B. hinter einem Reverse Proxy) läuft
COOKIE_SECURE=false
# Anzahl Reverse-Proxy-Hops (z. B. 1 hinter nginx/Caddy/Traefik), 0 = keiner
TRUST_PROXY=0
