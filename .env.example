# Kopieren nach .env (neben docker-compose.yml) und anpassen:  cp .env.example .env
# Alle Werte sind optional. Details: README.md und docs/hosting.md

# --- Öffentlicher Betrieb über HTTPS (Tunnel / Reverse Proxy) ---
# Sobald die App über https:// erreichbar ist, auf true setzen.
COOKIE_SECURE=false
# 1 hinter Cloudflare Tunnel oder einem Reverse Proxy, der X-Forwarded-For setzt; sonst 0
TRUST_PROXY=0
# Token aus dem Cloudflare-Zero-Trust-Dashboard (nur für: docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Port auf dem Host ---
# 127.0.0.1 = nur auf diesem Rechner erreichbar (z. B. wenn nur der Tunnel zugreifen soll)
PUBLISH_ADDRESS=0.0.0.0
PUBLISH_PORT=3000

# --- App ---
# Leer = wird automatisch erzeugt und im Daten-Volume gespeichert
JWT_SECRET=
# Leer = beim ersten Start wird ein zufälliger Code erzeugt und im Log ausgegeben
SETUP_CODE=
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=
